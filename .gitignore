# 가상환경 / 캐시
.venv/
__pycache__/
*.pyc
.DS_Store

# 다운로드되는 에셋 (00_asset_downloader.py 로 생성)
data/
output/
*.jpg
*.png
*.xml

# 단, 교재 그림은 커밋한다 (위 *.png/*.jpg 제외의 예외)
!교재/images/
!교재/images/*.png
!교재/images/*.jpg

# 얼굴 인식 실습에서 생성되는 산출물
05_face_recognition/dataset/
05_face_recognition/trainer/
05_face_recognition/names.json

# Teachable Machine 모델 (각자 내보내서 배치)
*.tflite

# 학습/모델 산출물
*.yml
*.dat

# 빌드 산출물 PDF (교재는 마크다운으로 배포, PDF는 별도 채널로)
*.pdf

# 참고: pyproject.toml 과 uv.lock 은 재현성을 위해 반드시 커밋합니다.
